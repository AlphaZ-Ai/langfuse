# Overrides for docker-compose-maestro.yml. Every variable has a working
# default in the compose file, so this file is optional: copy it to
# .env.maestro and uncomment what you want to change. update_maestro.sh
# sources it if present.

# Public URL of the Langfuse UI. Must match how you open it in the browser.
# export NEXTAUTH_URL=http://localhost:3100
# export NEXTAUTH_SECRET=maestro-secret

# Seeded project API keys. maestro_bench reads the same values from its own
# .env as LANGFUSE_PUBLIC_KEY / LANGFUSE_SECRET_KEY. Only applied on the first
# start of an empty database.
# export LANGFUSE_INIT_PROJECT_PUBLIC_KEY=pk-lf-maestro-bench
# export LANGFUSE_INIT_PROJECT_SECRET_KEY=sk-lf-maestro-bench

# Seeded UI login. Password must be at least 8 characters.
# export LANGFUSE_INIT_USER_EMAIL=maestro@example.com
# export LANGFUSE_INIT_USER_PASSWORD=maestro-bench

# UI batch export (CSV/JSON) of traces downloads straight from minio, which
# is published on host port 9094. If the UI is opened from another machine,
# set this to an address that machine can reach.
# export LANGFUSE_S3_BATCH_EXPORT_EXTERNAL_ENDPOINT=http://localhost:9094
